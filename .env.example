# Только пример для локального учебного стенда. Не используйте в production.
POSTGRES_DB=seps
POSTGRES_USER=seps
POSTGRES_PASSWORD=seps_local_password

RABBITMQ_DEFAULT_USER=seps
RABBITMQ_DEFAULT_PASS=seps_local_password

CACHE_TTL_SECONDS=60

# Четыре подсети /29: 172.28.10.0, .11.0, .12.0, .13.0.
# Если они пересекаются с VPN/LAN/Docker, выберите другой свободный префикс.
SEPS_NETWORK_PREFIX=172.28
